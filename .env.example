# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Required in production for signing/deriving session integrity (min 32 chars).
SESSION_SECRET="REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listen port (default 3000)
PORT="3000"
